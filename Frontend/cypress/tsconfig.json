{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "moduleResolution": "node16",
    "module": "Node16",
    "types": ["cypress", "@badeball/cypress-cucumber-preprocessor"]
  },
  "include": [
    "../node_modules/cypress",
    "**/*.ts",
    "**/*.js",
    "../../Security/**/*" // <-- añadida la carpeta Security (relativa a Frontend/cypress -> Codigo/Security)
  ]
}